# Copy this file to `.env` (it is git-ignored) and fill in the keys you want to use.
# The server reads it from the directory you start it in (`npm run start`).

# Claude: understands free-form and spoken instructions to pilots.
ANTHROPIC_API_KEY=

# ElevenLabs: realistic pilot voices (text to speech) and speech recognition for push-to-talk.
ELEVENLABS_API_KEY=

# --- optional -------------------------------------------------------------------------------
# Model used to interpret what you say. claude-haiku-5-5 is faster and cheaper than the default.
# ATC_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | none (low keeps radio calls quick)
# ATC_LLM_EFFORT=low
# Comma separated ElevenLabs voice ids for the pilots (default: the voices in your account)
# ELEVENLABS_VOICE_IDS=
