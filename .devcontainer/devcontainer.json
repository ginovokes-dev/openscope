{
    "name": "openScope",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "postCreateCommand": "sh .devcontainer/start.sh",
    "postAttachCommand": "sh .devcontainer/start.sh",
    "forwardPorts": [3003],
    "portsAttributes": {
        "3003": {
            "label": "openScope",
            "onAutoForward": "openBrowser"
        }
    }
}
